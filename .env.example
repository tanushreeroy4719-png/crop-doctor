# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_ENV=production

# AI Agronomist Report generation.
# If ANTHROPIC_API_KEY is left blank, the app automatically falls back
# to a rule-based report generator, so the app always works with zero cost.
ANTHROPIC_API_KEY=

# Max upload size in megabytes
MAX_UPLOAD_MB=8
